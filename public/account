<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Account · CoastLoop</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/styles.css">
</head>
<body>
<main class="shell" style="max-width:720px">
  <div class="topbar">
    <div class="brand coastloop-lockup">
      <img class="coastloop-mark"
        src="/brand/coastloop-mark.svg" alt="">
      <span>COASTLOOP</span>
    </div>
    <button id="back" class="secondary">Back</button>
  </div>

  <section class="card">
    <div class="eyebrow">ACCOUNT</div>
    <h1>My account</h1>
    <p id="who" class="muted">Loading account…</p>

    <h2 style="margin-top:28px">Security</h2>
    <p class="muted">
      Update the password used for email sign-in.
      Google sign-in continues to use your Google account.
    </p>

    <form id="password" class="account-password-form">
      <label>
        <span>New password</span>
        <input name="password" type="password"
          minlength="10" autocomplete="new-password"
          placeholder="At least 10 characters" required>
      </label>
      <label>
        <span>Confirm password</span>
        <input name="confirm" type="password"
          minlength="10" autocomplete="new-password"
          placeholder="Repeat new password" required>
      </label>
      <button>Update password</button>
    </form>

    <div id="msg" class="muted account-message"></div>

    <div class="account-actions">
      <button id="logout" class="secondary">Sign out</button>
    </div>
  </section>
</main>
<script type="module" src="/account.js"></script>
<script src="/legal-gate.js"></script>
</body>
</html>
