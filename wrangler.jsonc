{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coastloop",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "routes": [{"pattern":"coastloop.site","custom_domain":true},{"pattern":"www.coastloop.site","custom_domain":true}],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "coastloop-media"
    }
  ]
}
